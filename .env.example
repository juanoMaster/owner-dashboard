# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails transaccionales)
RESEND_API_KEY=

# Panel admin global (/admin)
ADMIN_TOKEN=

# Autenticación de cron jobs de Vercel
CRON_SECRET=

# URLs públicas de la plataforma
# NEXT_PUBLIC_APP_URL: dominio del panel. Setéalo a https://panel.takai.cl SOLO
# cuando ese dominio esté bien asignado en Vercel. El fallback en código es
# https://owner-dashboard-navy.vercel.app (URL estable que siempre sirve la app).
NEXT_PUBLIC_APP_URL=https://owner-dashboard-navy.vercel.app
NEXT_PUBLIC_RESERVAS_URL=https://reservas.takai.cl

# Twilio — SOLO notificaciones salientes (recordatorios, cancelaciones, avisos al
# dueño) y recepción de comprobantes en /api/twilio/webhook. NO es el agente IA.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Número WhatsApp del AGENTE IA (el chip registrado en Meta Cloud API — repo
# takai-agent, producción en ag.takai.cl). Setear SOLO cuando la app Meta esté
# publicada (Live). Mientras esté vacío, los botones de las landings caen al
# chat web https://<slug>.ag.takai.cl/embed (operativo hoy).
NEXT_PUBLIC_AGENT_WHATSAPP=

# Dominio del chat web del agente (takai-agent). Default en código: ag.takai.cl
NEXT_PUBLIC_AGENT_CHAT_DOMAIN=

# Botón WhatsApp POR CABAÑA en las cards de las landing templates.
# ACTIVO por defecto desde 2026-07-10 (agente IA configurado). Setear a "false"
# actúa como kill-switch sin cambios de código.
NEXT_PUBLIC_WA_CABIN_BUTTON=

# Suspensión AUTOMÁTICA de billing (cron billing-check). Apagada por defecto
# (decisión de Juan 2026-07-10): la suspensión/activación es manual desde
# /admin → Billing. Setear a "true" reactiva la suspensión automática.
BILLING_AUTO_SUSPEND=

# Health check (/api/health) — clave opcional para autorizar el endpoint vía header x-health-key o query ?key=
HEALTH_CHECK_KEY=

# Billing — suscripciones de Takai a sus tenants (INDEPENDIENTE del MP Marketplace de turistas)
# Access token de la cuenta propia de Takai en MercadoPago (no del tenant)
MP_PLATFORM_ACCESS_TOKEN=
# Secret HMAC para verificar webhooks de preapproval (se configura en el panel de MP de Takai)
MP_PLATFORM_WEBHOOK_SECRET=

# Datos bancarios de Takai para recibir comisiones por transferencia
# (se muestran en el email de estado de cuenta que recibe el tenant)
TAKAI_BANK_NAME=
TAKAI_BANK_ACCOUNT_TYPE=
TAKAI_BANK_ACCOUNT_NUMBER=
TAKAI_BANK_HOLDER_NAME=
TAKAI_BANK_HOLDER_RUT=
TAKAI_BANK_EMAIL=

# Email del administrador de Takai (alertas internas, acuse de transferencias)
ADMIN_EMAIL=contacto@takai.cl
