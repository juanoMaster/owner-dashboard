# Directorio B2C — variables de entorno
# Lee de la MISMA base Supabase que takai.cl (solo lectura, vía service role server-side).
NEXT_PUBLIC_SUPABASE_URL=https://yjphvjouyrwtkwuqfifl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__

# Dominio del directorio (B2C). Comprar y apuntar a Vercel. HUMAN_TODO.
DIRECTORY_DOMAIN=cabanasdelsur.cl
NEXT_PUBLIC_DIRECTORY_URL=https://cabanasdelsur.cl

# Motor de reservas existente (takai.cl) — destino de los botones "Reservar".
NEXT_PUBLIC_RESERVAS_URL=https://reservas.takai.cl

# Número WhatsApp del agente IA (el chip registrado en Meta Cloud API — takai-agent).
# Formato: +569... — setear SOLO cuando la app Meta esté publicada (Live).
# Mientras esté vacío, el botón cae al chat web https://<slug>.ag.takai.cl/embed.
# NO poner aquí el número Twilio (ese es solo para notificaciones del owner-dashboard).
NEXT_PUBLIC_AGENT_WHATSAPP=

# Dominio del chat web del agente (takai-agent). Default: ag.takai.cl
NEXT_PUBLIC_AGENT_CHAT_DOMAIN=

# Verificación Google Search Console (meta tag). HUMAN_TODO.
SEARCH_CONSOLE_VERIFICATION=
